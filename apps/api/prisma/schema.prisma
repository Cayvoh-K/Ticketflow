generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String?
  location        String
  date            DateTime
  totalTickets    Int
  availableTickets Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}